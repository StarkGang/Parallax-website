# ==============================================================================
# Parallax 2026 - Production Environment Variables
# ==============================================================================

# --- Application & Network ---
APP_ENV=production
APP_DEBUG=false
FRONTEND_ORIGIN=https://parallax-iste.vercel.app
APP_BASE_URL=https://parallax-iste.vercel.app
ALLOWED_HOSTS=parallax-iste.vercel.app,*.vercel.app

# --- Administrator / Owner Bootstrap ---
# Any user logging in with this email automatically receives full Owner & Super Admin privileges
ADMIN_EMAIL=your-email@gmail.com
BOOTSTRAP_OWNER_EMAIL=your-email@gmail.com

# --- Database (Supabase PostgreSQL Connection Pooler) ---
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000

# --- Google OAuth (Web Application Credentials) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Registered Authorized Redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=https://parallax-iste.vercel.app/google/callback

# --- Security & Session Tokens ---
# Generate 64-character secret using: python -c "import secrets; print(secrets.token_hex(32))"
SERVER_SECRET_KEY=generate-at-least-32-bytes-random-hex-key
SESSION_COOKIE_NAME=px_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
MFA_ENFORCED=false

# --- Supabase Storage (Optional for document uploads & icons) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=parallax
STORAGE_BACKEND=auto

# --- Razorpay Payments (Optional) ---
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
