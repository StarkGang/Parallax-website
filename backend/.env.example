# --- runtime ---
APP_ENV=development                 # development | staging | production | test
APP_DEBUG=true                      # must be false outside development
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1

# --- database (Supabase PostgreSQL in production/staging, SQLite for local dev/tests) ---
# Supabase connection string format:
# Direct: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Pooler (Transaction): postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# (postgresql:// and postgres:// are automatically normalized to postgresql+asyncpg://)
DATABASE_URL=sqlite+aiosqlite:///./var/parallax.db
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000

# --- Supabase Storage (for images, icons, and verification documents) ---
# When configured and STORAGE_BACKEND=auto (or supabase), uploads store directly in Supabase storage bucket
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=parallax

# --- Storage Backend selection: 'auto' | 'supabase' | 's3' | 'local' ---
# 'auto' automatically detects Supabase -> S3 -> LocalStorage fallback
# For offline local testing and development with local disk storage, use 'local'
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=./var/storage

# --- Auth: Pure Google Auth (Simple login, no MFA complications) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
MFA_ENFORCED=false                  # keep it easy: no MFA/TOTP roadblocks for admins or participants
ALLOW_DIRECT_LOGIN=true             # allows direct email-based login endpoint for testing/dev

# --- Sessions & Security ---
SESSION_COOKIE_NAME=px_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Base secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SERVER_SECRET_KEY=
BOOTSTRAP_OWNER_EMAIL=owner@parallax.local

# --- Local development sign-in ---
DEV_AUTH_ENABLED=true
DEV_ADMIN_EMAIL=owner@parallax.local
DEV_PARTICIPANT_EMAIL=participant@parallax.local
SEED_DEMO_DATA=true

# --- Payments ---
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- S3 Storage (Optional fallback if not using Supabase) ---
S3_ENDPOINT_URL=
S3_BUCKET_PRIVATE=parallax-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=120
